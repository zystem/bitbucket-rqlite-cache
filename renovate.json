{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": "Keep the chart image tag tied to Chart.appVersion by default",
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "ghcr.io/zystem/bitbucket-rqlite-cache"
      ],
      "enabled": false
    }
  ]
}
